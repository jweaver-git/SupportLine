@model IEnumerable<SupportLine.Models.Ticket>

@{
    ViewData["Title"] = "Agent Dashboard";
}

<style>
    .bg-orange {
        background-color: #fd7e14 !important;
        color: white;
    }

    /* Setting up Dark Red and Beige Theme*/
    body {
        background-color: #F5F5DC !important;
    }

    .bg-dark-red {
        background-color: #8B0000 !important;
        color: white !important;
    }

    .btn-primary {
        background-color: #8B0000 !important;
        border-color: #660000 !important;
        color: white !important;
    }

    .btn-primary:hover {
            background-color: #660000 !important;
            border-color: #4d0000 !important;
    }

    .card {
        border: 1px solid #8B0000;
    }
</style>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Welcome, @ViewBag.Username!</h2>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger shadow-sm">
            <strong>Bug Found:</strong> @ViewBag.ErrorMessage
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-dark-red">
            <h4 class="mb-0">Global Ticket Queue</h4>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Ticket ID</th>
                            <th>Customer Name</th>
                            <th>Subject</th>
                            <th>Description</th>
                            <th>Date Created</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center p-4 text-muted">
                                    There are currently no tickets in the queue!
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var ticket in Model)
                            {
                                <tr>
                                    <td class="align-middle">#@ticket.TicketID</td>
                                    <td class="align-middle">@ticket.CustomerName</td>

                                    <td class="align-middle fw-bold">
                                        <a asp-action="Details" asp-route-id="@ticket.TicketID" class="text-decoration-none text-red">
                                            @ticket.Subject
                                        </a>
                                    </td>

                                    <td class="align-middle">@(ticket.Description.Length > 50 
                                        ? ticket.Description.Substring(0,50) + "..." : ticket.Description)</td>
                                    <td class="align-middle">@ticket.DateCreated.ToString("MMM dd, yyyy h:mm:tt")</td>
                                    <td class="align-middle">
                                        @{
                                            string badgeClass = "bg-secondary";
                                            if (ticket.StatusName =="Open") badgeClass = "bg-primary";
                                            else if (ticket.StatusName =="In Progress") badgeClass = "bg-warning text-dark"; //Yellow
                                            else if (ticket.StatusName =="Resolved") badgeClass = "bg-success"; //Green
                                            else if (ticket.StatusName == "Closed") badgeClass = "bg-danger"; //Red
                                        }
                                        <span class="badge @badgeClass fs-6">@ticket.StatusName</span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>